APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

SEND_EXCEPTION_TO_MAIL=true
EXCEPTION_NOTIFICATION_EMAIL=geral@domingoasdez.com

FACEBOOK_CLIENT_ID=asdsadasd
FACEBOOK_CLIENT_SECRET=asdsadasd
FACEBOOK_CLIENT_CALLBACK=http://localhost:8000/login/facebook/callback
FACEBOOK_PAGE_ID=740853286020855
FACEBOOK_PAGE_ACCESS_TOKEN=SOMETHING

## NEW FACEBOOK STUFF
FB_APP_ID=xxxxxxxx
FB_APP_SECRET=xxxxxxxx
FB_SYSTEM_USER_TOKEN=EAAB...
FB_PAGE_ID=1234567890
FB_PAGE_ACCESS_TOKEN=EAAG...
IG_USER_ID=1789xxxxxxxxxxxx

GOOGLE_MAP_KEY=secret

LOG_CHANNEL=daily

ADSENSE_ENABLED=true
GOOGLE_ANALYTICS_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_CALLBACK=http://localhost:8000/login/google/callback

## Sign in with Apple. Left off until an Apple Developer account is available.
## To enable later: set APPLE_LOGIN_ENABLED=true and fill the values below.
## APPLE_PRIVATE_KEY is the .p8 contents with newlines written as \n.
APPLE_CLIENT_ID=
APPLE_CLIENT_CALLBACK=http://localhost:8000/login/apple/callback
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=

GOOGLE_LOGIN_ENABLED=true
FACEBOOK_LOGIN_ENABLED=true
APPLE_LOGIN_ENABLED=false
SOCIAL_LOGINS_ENABLED=true

## New-site prompt. false shows it to every visitor, true only to logged-in users.
NEW_SITE_PROMPT_LOGGED_IN_ONLY=false
NEW_SITE_URL=https://app.domingoasdez.com
## A/B: % of guests who get the new-site prompt. Logged-in users always get it when > 0. 0 disables it.
NEW_VERSION_AB_TEST=0
